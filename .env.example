# Copy to .env and fill in. Every variable the app reads is listed here.

# Postgres (Neon). Use the POOLED connection string (-pooler host) for the
# app; keep the direct URL for migrations only. For local dev, point this at
# a Neon branch of the database — never the production branch.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Claude — powers the AI team/matchup explanations (/api/explain).
ANTHROPIC_API_KEY="sk-ant-..."

# Signs the anonymous device-identity cookie (team ownership, lobby entries).
# REQUIRED in production — a known secret lets anyone forge identities and
# claim other devices' teams. Dev falls back to a fixed secret if unset.
# ANON_COOKIE_SECRET is an optional override; AUTH_SECRET is the default.
AUTH_SECRET="generate-with: openssl rand -base64 32"
# ANON_COOKIE_SECRET=""

# Optional: feedback link shown in the UI (omit to hide it).
# NEXT_PUBLIC_FEEDBACK_URL="https://..."
